# Порт HTTP /metrics
AMNEZIA_EXPORTER_PORT=9352

# Сколько секунд между реальными вызовами awg/wg (кеш)
AMNEZIA_SCRAPE_INTERVAL=30

# 0 — не дергать wg/awg
# 1 — парсить dump, метрики amnezia_wg_peer_* по каждому peer
AMNEZIA_WG_ENABLE=1
# Для AmneziaWG: awg show all dump; для классического WG: wg show all dump
AMNEZIA_WG_CMD=awg show all dump
AMNEZIA_WG_TIMEOUT=5

# Источники имён для label name (приоритет сверху вниз)
# 1) Реестр клиентов Amnezia-сервера, несколько путей через ":"
AMNEZIA_CLIENTS_TABLE=/opt/amnezia/awg/clientsTable:/opt/amnezia/wireguard/clientsTable
# 2) Каталог с *.conf, где над [Peer] стоит "# Name: alice"
AMNEZIA_PEERS_CONF_DIR=/etc/amnezia/amneziawg
# 3) JSON-файл вида {"<pubkey>": "<name>"} — для ручных правок
AMNEZIA_PEERS_JSON=/data/peers.json

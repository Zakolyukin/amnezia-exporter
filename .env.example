# Порт HTTP /metrics
AMNEZIA_EXPORTER_PORT=9352

# Сколько секунд между реальными вызовами awg/wg (кеш)
AMNEZIA_SCRAPE_INTERVAL=30

# 0 — не дергать wg/awg
# 1 — парсить dump, метрики amnezia_wg_peer_* по каждому peer
AMNEZIA_WG_ENABLE=0
AMNEZIA_WG_CMD=wg show all dump
AMNEZIA_WG_TIMEOUT=5

# Источники имён для label name
# JSON-файл вида {"<pubkey>": "<name>"}
AMNEZIA_PEERS_JSON=/data/peers.json
# Каталог с *.conf, где над [Peer] стоит "# Name: alice"
AMNEZIA_PEERS_CONF_DIR=/etc/wireguard
